{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apto-app",
	// Entrypoint propio, no el worker que genera OpenNext: envuelve ese worker
	// para agregarle el handler `scheduled` del keep-alive. Ver custom-worker.ts.
	"main": "./custom-worker.ts",
	// nodejs_compat + una compatibility_date >= 2024-09-23 son obligatorias:
	// sin las dos, el worker que genera @opennextjs/cloudflare no arranca.
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Acá va SOLO lo que puede publicarse. Las credenciales de Supabase NO
	// están en este archivo a propósito: el repo es público y, aunque la
	// publishable key esté diseñada para viajar al navegador y la proteja Row
	// Level Security, publicarla revelaría contra qué proyecto corre esta app.
	//
	// Las cuatro van como secretos, igual que las que sí son secretas:
	//
	//   npx wrangler secret put SUPABASE_URL
	//   npx wrangler secret put SUPABASE_ANON_KEY
	//   npx wrangler secret put NEXT_PUBLIC_SUPABASE_URL
	//   npx wrangler secret put NEXT_PUBLIC_SUPABASE_ANON_KEY
	//   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY   <- esta sí es secreta
	//   npx wrangler secret put GEMINI_API_KEY              <- esta también
	//
	// Dato que costó descubrir: Cloudflare RECHAZA un secreto que se llame igual
	// que un `var` ("Binding name already in use", código 10053). No hay
	// precedencia entre ambos, hay conflicto — por eso estas claves no pueden
	// estar en los dos lados "por las dudas".
	//
	// En desarrollo las lee .dev.vars (gitignored). Ver .dev.vars.example.
	"vars": {
		"OFF_API_BASE_URL": "https://world.openfoodfacts.org"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Cache incremental de Next.js. Crear con:
	//   npx wrangler kv namespace create apto-inc-cache
	// y pegar el id que devuelve. Se habilita en open-next.config.ts.
	//
	// `binding` es el nombre con el que el código lo ve (env.NEXT_INC_CACHE_KV) y
	// lo fija el adapter; el título del namespace en el dashboard es aparte y
	// puede ser cualquiera. Conviene que sea distinguible: si la cuenta tiene
	// otros Workers, dos namespaces titulados igual se confunden, y compartir uno
	// haría que las entradas de caché de dos apps colisionen.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "6905700cafa64dc281fac428192a97a9"
		}
	],
	// Frena fuerza bruta contra /api/vinculacion (código de 4 caracteres,
	// ~924.000 combinaciones — no es un límite duro, pero corta las ráfagas
	// automatizadas). `period` solo admite 10 o 60 segundos.
	//
	// `namespace_id` identifica el contador dentro de la cuenta, no dentro de
	// este Worker: dos Workers de la misma cuenta que usen el mismo número
	// podrían compartir cuota. Por eso no es "1001", que es el valor con el que
	// suele quedar un proyecto recién armado y el más probable de chocar.
	"ratelimits": [
		{
			"name": "VINCULACION_RATE_LIMITER",
			"namespace_id": "4821",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		// Frena el abuso del OCR, que es la ruta más cara del proyecto: cada
		// llamada consume una de las 20 diarias del free tier de Gemini. Sin
		// esto, un script agota la cuota en segundos y deja el OCR muerto por
		// el resto del día.
		//
		// Contador propio y no el de vinculación: son rutas con costos
		// distintos y compartir cuota haría que el tráfico de una castigue a
		// la otra.
		//
		// Honestidad sobre lo que protege: `period` solo admite 10 o 60
		// segundos, así que un límite por minuto no puede defender de verdad un
		// presupuesto DIARIO. A 3 por minuto, un atacante decidido igual agota
		// las 20 en unos siete minutos. Lo que esto corta es el abuso casual y
		// el bucle accidental, que es el caso realista.
		{
			"name": "OCR_RATE_LIMITER",
			"namespace_id": "4822",
			"simple": {
				"limit": 3,
				"period": 60
			}
		}
	],
	// Keep-alive cada 3 días: el free tier de Supabase pausa el proyecto a los
	// 7 días sin actividad y un ping HTTP no cuenta — tiene que ser un query
	// real. Handler `scheduled` en custom-worker.ts.
	"triggers": {
		"crons": [
			"0 12 */3 * *"
		]
	}
}
